# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get huge, so they should be ignored
/[Mm]emoryCaptures/

# Asset meta data should only be ignored for specific local dev folders
/[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio and MonoDevelop files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity 3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin

# Temporary C# project files
.vs/
.gradle/
.expo/
export/

# Intellij Rider
.idea/
